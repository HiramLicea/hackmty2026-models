# Runtime
APP_ENV=development
LOG_LEVEL=INFO
DOCS_ENABLED=true

# Server-only Supabase configuration. Never expose or prefix these with EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared server-to-server credential used only by MCP and this API.
MCP_API_KEY=

# Read-only model files packaged with the deployment.
MODEL_ARTIFACT_DIR=artifacts
MODEL_MANIFEST_PATH=artifacts/manifest.json
